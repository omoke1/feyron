{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/site/assets/brand/(.*)\\.(mp4|dat)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!site/|assets/|mascot\\.js|mascot\\.css|game\\.js|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
